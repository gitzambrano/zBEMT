{
  "Ne": 72,
  "Npsi": 108,
  "rho": 1.225,
  "a_sound": 340.294,
  "nu_air": 1.46e-05,
  "integration_offset": 0.005,
  "is_propeller": false,
  "inflow_field_model": "coleman_local",
  "prandtl_loss_mode": "both",
  "use_compressibility": true,
  "reverse_flow_model": "flat_plate",
  "reverse_flow_blend_factor": 5.0,
  "thin_plate_blend_center_deg": 35.0,
  "thin_plate_blend_width_deg": 20.0,
  "mask_reverse_flow_plots": true,
  "use_rotational_augmentation": false,
  "use_radial_flow_correction": false,
  "radial_flow_max_skew_deg": 60.0,
  "pitt_peters_states": 3,
  "pitt_peters_outer_iter": 40,
  "pitt_peters_relax": 0.5,
  "pitt_peters_tol": 1e-06,
  "use_dynamic_stall": false,
  "dynamic_stall_model": "oye",
  "dynamic_stall_method": "frequency",
  "dynamic_stall_A": 8.0,
  "dynamic_stall_fade_start_deg": 40.0,
  "dynamic_stall_fade_end_deg": 50.0,
  "dynamic_stall_f_reg": 0.001,
  "dynamic_stall_time_march_revolutions": 8,
  "dynamic_stall_time_march_avg_last": 3,
  "solver": "newton",
  "max_iter": 200,
  "tol": 1e-06,
  "relax": 0.4,
  "relax_schedule": true,
  "relax_root_factor": 0.25,
  "relax_root_threshold": 0.3,
  "relax_tip_threshold": 0.93,
  "relax_azimuth_factor": 0.5,
  "relax_azimuth_threshold": 0.3,
  "collect_history": true,
  "early_exit_fraction": 0.999,
  "stagnation_patience": 15,
  "stagnation_min_frac": 0.95
}